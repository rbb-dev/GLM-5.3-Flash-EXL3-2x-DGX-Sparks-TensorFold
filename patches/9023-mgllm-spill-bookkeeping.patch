+    def _room(self, job: Job, need: int) -> None:
+        """The writer (9023), before any byte of ``job``'s state: the room ``persist`` used to make on the engine's loop
+        as the state was kept, walking every stored state while every stream waited: its conversation's own old turns
+        and forks past its quota (``_trim_own``), then the cap's or the free-disk floor's shortfall (``_make_room``), in
+        the same order. Still short, the state is not written (``no_space``; its writes are skipped). Never raises."""
+
+        pt = job.point
+        try:
+            if self.quota > 0:
+                self._trim_own(pt, need)
+            other = self.backlog - job.size                 # (what else waits, as persist counted it)
+            short = self.floor + need + other - self.disk_free()
+            over = self.stored() + other + need - self.cap
+            if short > 0 or over > 0:
+                self._make_room(max(short, over), protect={pt.key})
+                short = self.floor + need + other - self.disk_free()
+                if short > 0 or self.stored() + other + need > self.cap:
+                    self.stats["no_space"] += 1
+                    job.failed = NoRoom(f"{pt.key}: no room for it on this disk")
+        except Exception as exc:                            # noqa: BLE001  (then it is written as it would have been)
+            print(f"[tensorfold] spill rank {self.rank}: making room for {pt.key} failed: {exc!r}", flush=True)
+
