+def to_wire(values):
+    """Rank 0's message as one int32 host tensor (int32 on the wire): from an array without a pass over Python
+    objects (9009), from a list as before."""
+
+    import numpy as np
+    import torch
+
+    if isinstance(values, np.ndarray):
+        return torch.from_numpy(np.ascontiguousarray(values, dtype=np.int32))
+    return torch.tensor(values, dtype=torch.int32)
+
+
+def from_wire(t, as_array: bool = False):
+    """A received message: an int64 array (``as_array``, 9009), else a list of ints, each made in one C pass."""
+
+    a = t.cpu().numpy()
+    return a.astype("int64") if as_array else a.tolist()
+
