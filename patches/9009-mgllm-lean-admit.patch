+def int_array(values: Sequence[int], chunk: int = 1 << 14) -> np.ndarray:
+    """9009: ``values`` (Python ints) as an int32 array, converted in pieces of ``chunk``, so no one conversion keeps
+    the GIL for long: a request thread's work, which the engine's loop runs between."""
+
+    out = np.empty((len(values),), dtype=np.int32)
+    for i in range(0, len(values), chunk):
+        out[i:i + chunk] = values[i:i + chunk]
+    return out
 
 
