+    def _spill_ints(self) -> list[int]:
+        """9028: this rank's SSD store for rank 0's /health (``SPILL_RANK_KEYS``), as the memory guard's all-gather
+        carries it: int32, so sizes in MiB. Zeros without a store or when a read fails: every rank must send the same
+        length, or the all-gather waits forever."""
+
+        d = getattr(self, "disk", None)
+        if d is None:
+            return [0] * len(SPILL_RANK_KEYS)
+        try:
+            s = d.stats
+            return [int(d.stored()) >> 20, int(s["written_bytes"] + s["written_small_bytes"]) >> 20, len(d.index),
+                    len(d.have), int(s["written"]), int(d.disk_free()) >> 20]
+        except Exception:                        # noqa: BLE001  (a table changing under the read: send zeros)
+            return [0] * len(SPILL_RANK_KEYS)
+
+    def _spill_health(self) -> dict:
+        """/health (rank 0): this rank's store, and 9028 every rank's at the last memory guard all-gather (``ranks``,
+        sizes in MiB; ``ranks_age_s``: how old that is; none before the first)."""
+
+        info = self.disk.info()
+        ranks = getattr(self, "spill_ranks", None)
