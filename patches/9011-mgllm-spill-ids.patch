+def as_ids(ids: Sequence[int]) -> np.ndarray:
+    """9011: token ids as one int64 array: an array as it is, a list of ints in one C pass (``array('q')``, two to
+    four times faster than ``np.asarray`` on a list of a million)."""
+
+    if isinstance(ids, np.ndarray):
+        return ids.astype(np.int64, copy=False)
+    return np.frombuffer(_ints("q", ids), dtype=np.int64)
+
+
+def ids_field(ids: np.ndarray, wide: bool) -> str:
+    """9011: a header field holding ``ids``: a width letter, then base64 of the raw little-endian values, int32 for a
+    prompt's ids or int64 (``wide``) for keyed ids, whose picture rows hold -1 - a 62-bit key."""
+
+    data = np.asarray(ids).astype("<i8" if wide else "<i4", copy=False).tobytes()
+    return ("q" if wide else "i") + base64.b64encode(data).decode("ascii")
+
+
+def ids_from_field(text: str) -> np.ndarray:
+    """``ids_field`` read back, as int64."""
+
+    return np.frombuffer(base64.b64decode(text[1:]), dtype={"q": "<i8", "i": "<i4"}[text[0]]).astype(np.int64)
+
+
 def ids_key(ids: Sequence[int]) -> tuple[int, int]:
-    h = hashlib.sha1(np.asarray(ids, dtype=np.int64).tobytes()).digest()
+    h = hashlib.sha1(as_ids(ids).tobytes()).digest()
     return int.from_bytes(h[0:4], "big", signed=True), int.from_bytes(h[4:8], "big", signed=True)
 
 
