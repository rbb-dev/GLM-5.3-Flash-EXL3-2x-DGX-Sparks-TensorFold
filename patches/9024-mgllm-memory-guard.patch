+"""Patch 9024: the memory guard of a GLM-5.3-Flash rank (``multi.MultiDecoder`` drives it from its loop).
+
+A GB10's GPU and CPU share one memory, and nothing watched what the engine left free: on 2026-10-12 node2 fell to 471
+MB available while serving, from torch's cache of freed GPU blocks (+2.2 GiB in two hours; Python's heap grew 0.34
+GiB in 28 hours). Each rank reads its own MemAvailable about once a second (``sample``) and keeps a level:
+
+- normal from ``normal_at`` (2.0 GiB), and back to normal only above it;
+- tight below ``tight_below`` (1.5 GiB): torch's unused cache released and a full Python collection, between two
+  rounds, at most every ``TIGHT_EVERY`` seconds (releasing the cache on every kept-state drop cost decode 16%, so only
+  under pressure);
+- critical below ``critical_below`` (1.0 GiB): the same, and every saved GPU state dropped on both ranks (written to
+  the spill tier when kept, they come back on their next turn), at most every ``CRITICAL_EVERY`` seconds.
+
+Admission never stops. This module only keeps the levels, limits and counts; the decoder does the actions and tells it
+what each freed (``done``)."""
+
+from __future__ import annotations
+
+import os
+import time
+from typing import Any, Callable
+
+GIB = 1 << 30
+MIB = 1 << 20
+NORMAL, TIGHT, CRITICAL = 0, 1, 2
+LEVELS = ("normal", "tight", "critical")
+POLL_S = 1.0                     # MemAvailable read at most this often
+TIGHT_EVERY = 30.0               # seconds between two tight actions at most
+CRITICAL_EVERY = 5.0             # seconds between two critical actions at most
+DEFAULT = (2.0, 1.5, 1.0)        # GiB: normal from, tight below, critical below
+
+
+def settings(value: str | None = None) -> tuple[int, int, int] | None:
+    """TF_GLM_MEMORY_GUARD: "0" off; else three GiB values, "normal,tight,critical" (default "2.0,1.5,1.0"), each
+    lower than the one before. Bytes, or None when off."""
+
+    raw = (os.environ.get("TF_GLM_MEMORY_GUARD", "") if value is None else value).strip()
+    if raw == "0":
+        return None
+    try:
+        parts = tuple(float(v) for v in raw.split(",")) if raw else DEFAULT
+    except ValueError:
+        parts = ()
+    if len(parts) != 3 or not parts[0] >= parts[1] > parts[2] > 0:
+        raise ValueError(f"TF_GLM_MEMORY_GUARD: 0, or three GiB values normal,tight,critical, falling, not {raw!r}")
+    return tuple(int(v * GIB) for v in parts)                # type: ignore[return-value]
+
+
+def mem_available(path: str = "/proc/meminfo") -> int | None:
+    """This machine's MemAvailable in bytes, or None when it cannot be read."""
+
+    try:
+        with open(path) as fh:
+            for line in fh:
+                if line.startswith("MemAvailable:"):
+                    return int(line.split()[1]) * 1024
+    except (OSError, ValueError, IndexError):
+        return None
+    return None
+
+
+class MemoryGuard:
+    """One rank's level, its action limits and what its actions freed."""
+
+    def __init__(self, levels: tuple[int, int, int] | None = None, *, read: Callable[[], int | None] = mem_available,
+                 clock: Callable[[], float] = time.monotonic) -> None:
+        self.normal_at, self.tight_below, self.critical_below = levels or tuple(int(v * GIB) for v in DEFAULT)
+        self.read, self.clock = read, clock
+        self.level, self.avail, self.read_at = NORMAL, None, None
+        self.last = {"tight": float("-inf"), "critical": float("-inf")}
+        self.actions = {"tight": 0, "critical": 0}
+        self.freed = {"cache_mib": 0.0, "states": 0, "collected": 0}
+        self.last_action: dict[str, Any] = {}
+
+    def sample(self) -> int:
+        """Read MemAvailable now and set the level; returns it. A failed read changes nothing. Never raises."""
+
+        try:
+            a = self.read()
+        except Exception:                                    # noqa: BLE001
+            a = None
+        self.read_at = self.clock()
+        if a is None:
+            return self.level
+        self.avail = int(a)
+        if a < self.critical_below:
+            self.level = CRITICAL
+        elif a < self.tight_below:
+            self.level = TIGHT
+        elif a >= self.normal_at:
+            self.level = NORMAL
+        elif self.level != NORMAL:                           # between tight and normal: not normal again yet
+            self.level = TIGHT
+        return self.level
+
+    def due_sample(self) -> bool:
+        return self.read_at is None or self.clock() - self.read_at >= POLL_S
+
+    def due(self) -> str | None:
+        """The action due now at this level: "critical", "tight" or None (each within its own limit)."""
+
+        now = self.clock()
+        if self.level == CRITICAL and now - self.last["critical"] >= CRITICAL_EVERY:
+            return "critical"
+        if self.level >= TIGHT and now - self.last["tight"] >= TIGHT_EVERY:
+            return "tight"
+        return None
+
+    def done(self, kind: str, freed: dict[str, Any]) -> None:
+        """An action ended: its limit restarts (a critical one also counts as tight's), and what it freed counts."""
+
+        now = self.clock()
+        self.last[kind] = now
+        if kind == "critical":
+            self.last["tight"] = now
+        self.actions[kind] += 1
+        for k in ("cache_mib", "states", "collected"):
+            if freed.get(k):
+                self.freed[k] += freed[k]
+        self.last_action = {"kind": kind, "at_available_mib": (self.avail or 0) // MIB, **freed}
+
+    def status(self, reserved: int = 0, allocated: int = 0) -> list[int]:
+        """[level, MemAvailable MiB, torch reserved MiB, torch allocated MiB]: what MEMQ gathers from each rank."""
+
+        return [self.level, (self.avail or 0) // MIB, int(reserved) // MIB, int(allocated) // MIB]
+
+    def health(self, reserved: int = 0, allocated: int = 0) -> dict[str, Any]:
+        level, avail, res, alloc = self.status(reserved, allocated)
+        return {"level": LEVELS[level], "available_mib": avail, "torch_reserved_mib": res, "torch_allocated_mib": alloc,
+                "levels_gib": [round(v / GIB, 2) for v in (self.normal_at, self.tight_below, self.critical_below)],
+                "actions": dict(self.actions), "freed": dict(self.freed), "last": dict(self.last_action)}
