+    # -- 9024: the memory guard (memory_guard.py) ---------------------------------------------------------------------
+    def _mem_tick(self) -> None:
+        """Both ranks, between iterations, at most once a second: read this Spark's MemAvailable. Rank 0, while streams
+        are live, then has both ranks gather their status (MEMQ, sent now: rank 1 gathers as it applies it). Then the
+        action due, if any. Never the engine's failure: a guard that raises is only a guard that did nothing."""
+
+        g = getattr(self, "mem_guard", None)
+        if g is None or not g.due_sample():
+            return
+        try:
+            g.sample()
+            if self.rank == 0 and self.lanes and self.w.world > 1:
+                self._emit(MEMQ, [])
+                self._flush()
+                self._mem_gather()
+            self._mem_act()
+        except Exception as exc:                 # noqa: BLE001
+            print(f"[tensorfold] memory guard rank {self.rank}: {exc!r}", flush=True)
+
+    def _mem_gather(self) -> None:
+        """Both ranks (MEMQ): every rank's [level, MemAvailable MiB, torch reserved MiB, torch allocated MiB]."""
+
+        g = getattr(self, "mem_guard", None)
+        if g is not None and g.avail is None:
+            g.sample()                  # rank 1's first MEMQ can arrive before its own first sample: read it now, not 0
+        cuda = torch.cuda.is_available()
+        mine = g.status(torch.cuda.memory_reserved() if cuda else 0, torch.cuda.memory_allocated() if cuda else 0) \
+            if g is not None else [0, 0, 0, 0]
+        rows = self.g._gather_ints(mine)
+        self.mem_ranks = {r: [int(v) for v in row] for r, row in enumerate(rows)}
+        self.mem_ranks_at = time.monotonic()
+
+    def _mem_act(self) -> None:
+        """The action due: tight, this Spark's own torch cache released and a full collection; critical, also every
+        saved GPU state dropped on both ranks, which rank 0 decides when any rank is critical (its EVICTs reach rank 1
+        in its next message). Each at most as often as ``memory_guard`` allows; admission never stops."""
+
+        g = self.mem_guard
+        worst = max([g.level] + [row[0] for row in self.mem_ranks.values()]) if self.rank == 0 else g.level
+        drop = self.rank == 0 and worst == memory_guard.CRITICAL and \
+            g.clock() - g.last["critical"] >= memory_guard.CRITICAL_EVERY
+        kind = "critical" if drop else g.due()
+        if kind is None:
+            return
+        freed: dict = {}
+        if drop:
+            states = list(self.kept)
+            for c in states:
+                self._evict(c, spill=False)
+            freed["states"] = len(states)
+        if g.level >= memory_guard.TIGHT:
+            freed.update(self._mem_release())
+        g.done(kind, freed)
+        print(f"[tensorfold] memory guard rank {self.rank}: {kind} at {(g.avail or 0) >> 20} MiB available"
+              f" (worst rank {memory_guard.LEVELS[worst]}): {freed}", flush=True)
+
+    @staticmethod
+    def _mem_release() -> dict:
+        """This Spark: torch's unused cache back to the system, then a full Python collection; what each freed."""
+
+        import gc
+
+        cuda = torch.cuda.is_available()
+        before = torch.cuda.memory_reserved() if cuda else 0
+        t = time.perf_counter()
+        if cuda:
+            torch.cuda.empty_cache()
+        after = torch.cuda.memory_reserved() if cuda else 0
+        n = gc.collect()
+        return {"cache_mib": round((before - after) / memory_guard.MIB, 1), "collected": n,
+                "release_s": round(time.perf_counter() - t, 3)}
+
+    def _mem_health(self) -> dict:
+        """/health (rank 0): this Spark's guard, and every rank's status at the last MEMQ."""
+
+        g = self.mem_guard
+        cuda = torch.cuda.is_available()
+        mine = g.health(torch.cuda.memory_reserved() if cuda else 0, torch.cuda.memory_allocated() if cuda else 0)
+        ranks = {str(r): {"level": memory_guard.LEVELS[row[0]], "available_mib": row[1], "torch_reserved_mib": row[2],
+                          "torch_allocated_mib": row[3]} for r, row in sorted(self.mem_ranks.items())}
+        age = round(time.monotonic() - self.mem_ranks_at, 1) if self.mem_ranks_at is not None else None
+        return {**mine, "ranks": ranks, "ranks_age_s": age}
+
     def _evict(self, c, spill: bool = True) -> None:
         """Rank 0: drop a kept prompt on both ranks."""
 
