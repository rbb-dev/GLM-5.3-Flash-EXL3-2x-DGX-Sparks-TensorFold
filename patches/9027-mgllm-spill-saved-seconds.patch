          "rounds": "rounds_total", "drafted": "drafted_total", "accepted": "accepted_total",
          "loop_guard": "loop_guard_total"}     # 9025: the loop guard's fires (TF_GLM_LOOP_GUARD), summed
 _MADE = threading.Lock()
+REAL_PROMPT = 1024     # 9027: uncached tokens from which a finished request's prefill speed counts (the board's filter)
+PRICE_WINDOW = 32      # 9027: the last this many such requests make the speed restores are priced at
 
 
