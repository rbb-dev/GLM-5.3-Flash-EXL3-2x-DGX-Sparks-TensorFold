             if isinstance(value, (int, float)) and not isinstance(value, bool):
                 t[name] += value
+        self._price(request)
+
+    def _price(self, request: Request) -> None:
+        """9027: the engine's own prefill speed over its last ``PRICE_WINDOW`` finished requests with at least
+        ``REAL_PROMPT`` uncached tokens; rank 0's spill tier prices each restore at it, once, when the restore happens."""
+
+        stats = request.stats or {}
+        pre, cached = stats.get("prefill_s"), stats.get("cached", 0)
+        if not isinstance(pre, (int, float)) or isinstance(pre, bool) or pre <= 0:
+            return
+        if not isinstance(cached, (int, float)) or isinstance(cached, bool):
+            cached = 0
+        uncached = request.prompt - cached
+        if uncached < REAL_PROMPT:
+            return
+        self.prefill.append((int(uncached), float(pre)))
+        del self.prefill[:-PRICE_WINDOW]
+        self.prefill_tps = sum(u for u, _ in self.prefill) / sum(s for _, s in self.prefill)
+        engine = getattr(getattr(self, "app", None), "engine", None)
+        disk = getattr(getattr(getattr(engine, "scheduler", None), "decoder", None), "disk", None)
+        if disk is not None and hasattr(disk, "price_tps"):
+            disk.price_tps = self.prefill_tps
 
