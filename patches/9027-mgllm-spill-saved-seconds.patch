                                                        "completion_tokens_total", *STATS.values()), 0)
+        self.prefill: list[tuple[int, float]] = []          # 9027: (uncached tokens, prefill s) of the last real prompts
+        self.prefill_tps: float | None = None
 
     @contextmanager
     def running(self, prompt: int, out: list[int], arrived: float | None = None):
@@ -63,6 +67,28 @@ class Health:
