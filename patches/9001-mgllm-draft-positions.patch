+    def _count_drafts(self, source: str, drafted: int, accepted: int) -> None:
+        """One stream's round: its draft's source, then positions 1..``drafted`` drafted and 1..``accepted`` kept (a
+        kept draft token's earlier positions were all kept). Counts only; drafts and replies are unchanged."""
+
+        c = self.draft_counts.get(source)
+        if c is None:
+            c = self.draft_counts[source] = {"rounds": 0, "drafted": [], "accepted": []}
+        c["rounds"] += 1
+        for row, n in ((c["drafted"], drafted), (c["accepted"], accepted)):
+            if len(row) < n:
+                row.extend([0] * (n - len(row)))
+            for p in range(n):
+                row[p] += 1
+
