+def _drafts(lines: list[str], drafts: Any) -> None:
+    """The concurrent engine's live draft counts (/health's drafts): each stream's decode rounds by the source of its
+    draft, and per draft position the rounds that drafted it and the rounds that kept it (positions from 1)."""
+
+    if not isinstance(drafts, dict) or not drafts:
+        return
+    rounds, drafted, accepted = [], [], []
+    for source in sorted(drafts):
+        d = drafts[source] if isinstance(drafts[source], dict) else {}
+        made, kept = list(d.get("drafted") or ()), list(d.get("accepted") or ())
+        rounds.append(f'{HEALTH}draft_rounds_total{{source="{source}"}} {_num(d.get("rounds", 0))}')
+        for p, n in enumerate(made, 1):
+            label = f'source="{source}",position="{p}"'
+            drafted.append(f"{HEALTH}draft_position_drafted_total{{{label}}} {_num(n)}")
+            accepted.append(f"{HEALTH}draft_position_accepted_total{{{label}}} {_num(kept[p - 1] if p <= len(kept) else 0)}")
+    _family(lines, "draft_rounds_total", "counter",
+            "Decode rounds of each stream since start, by its draft's source (dflash2, copy, none).", rounds, HEALTH)
+    if drafted:
+        _family(lines, "draft_position_drafted_total", "counter",
+                "Rounds since start whose draft reached this position.", drafted, HEALTH)
+        _family(lines, "draft_position_accepted_total", "counter",
+                "Rounds since start whose draft token at this position was kept.", accepted, HEALTH)
 
 
