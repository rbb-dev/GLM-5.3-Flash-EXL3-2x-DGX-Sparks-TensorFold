diff --git tensorfold/cuda/unlocked.py tensorfold/cuda/unlocked.py
new file mode 100644
index 0000000..cdcd8c9
--- /dev/null
+++ tensorfold/cuda/unlocked.py
@@ -0,0 +1,21 @@
+"""Patch 9006: tokenize with Python's lock released.
+
+The Rust tokenizer's single-text ``encode`` holds the GIL for the whole text (measured on a GB10 core: 1.75 s for
+996,815 tokens), during which no other thread of the engine process runs, the decode loop of every other request
+included. Its batch calls release the GIL while Rust tokenizes and return the same ids; ``encode_batch_fast`` skips
+the character offsets prompts never use (on a GB10 core as fast as ``encode``; on an x86 workstation twice as fast).
+Only turning the ids into a Python list holds the GIL (about 18 ms at 1M tokens on GB10)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def encode_ids(tok: Any, text: str, add_special_tokens: bool) -> list[int]:
+    """``text``'s token ids, as ``tok.encode(text, add_special_tokens=...).ids`` gives them, without holding the GIL (a
+    tokenizer with no batch call, as the stand-ins in TensorFold's tests are, is asked with ``encode``)."""
+
+    batch = getattr(tok, "encode_batch_fast", None) or getattr(tok, "encode_batch", None)  # _fast: tokenizers 0.20+
+    if batch is None:
+        return tok.encode(text, add_special_tokens=add_special_tokens).ids
+    return batch([text], add_special_tokens=add_special_tokens)[0].ids
