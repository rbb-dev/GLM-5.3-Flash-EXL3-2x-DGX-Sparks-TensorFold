+def max_body_bytes() -> int:
+    """9013: the body limit of every route that takes pictures (chat, Anthropic Messages, Responses):
+    TENSORFOLD_MAX_BODY_MIB, 1 to 4,096, default 96. Pictures and clips come in the body as data URLs and share it (no
