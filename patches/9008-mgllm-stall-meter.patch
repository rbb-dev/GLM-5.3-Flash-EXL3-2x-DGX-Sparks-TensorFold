@@ -0,0 +1,68 @@
+"""Patch 9008: the engine's stall meter (rank 0). While streams decode, the time between two decode rounds is time
+every one of them waits. It is measured here, inside the engine: a client sees it only behind the stream smoothing,
+which hides pauses up to about 0.4 s. Each gap is broken down by what the scheduler did in between (``phase``)."""
+
+from __future__ import annotations
+
+import threading
+import time
+from collections import deque
+from collections.abc import Callable, Generator
+from contextlib import contextmanager
+
+BUCKETS = (0.05, 0.1, 0.25, 0.5, 1.0)          # seconds: /health counts the gaps at or past each
+
+
+class StallMeter:
+    """``round_start``/``round_end`` around each decode round; ``phase(name)`` around each scheduler step between."""
+
+    def __init__(self, *, clock: Callable[[], float] = time.perf_counter, wall: Callable[[], float] = time.time,
+                 listed_s: float = 0.05, keep: int = 32) -> None:
+        self.clock, self.wall, self.listed_s = clock, wall, listed_s
+        self.last_end: float | None = None         # the last decode round's end, while streams still decode
+        self.parts: dict[str, float] = {}           # what ran since then, by phase
+        self.recent: deque = deque(maxlen=keep)     # the last gaps of ``listed_s`` or more
+        self.gaps = 0
+        self.worst = 0.0
+        self.over = {b: 0 for b in BUCKETS}
+        self.lock = threading.Lock()                # /health reads from another thread
+
+    def round_start(self) -> None:
+        now = self.clock()
+        if self.last_end is not None:
+            gap = now - self.last_end
+            parts = {k: round(v, 3) for k, v in self.parts.items() if v > 0}
+            other = gap - sum(self.parts.values())
+            if other > 0.0005:
+                parts["other"] = round(other, 3)
+            with self.lock:
+                self.gaps += 1
+                self.worst = max(self.worst, gap)
+                for b in BUCKETS:
+                    if gap >= b:
+                        self.over[b] += 1
+                if gap >= self.listed_s:
+                    self.recent.append({"gap_s": round(gap, 3), "ended": self.wall(), "parts": parts})
+        self.last_end = None
+        self.parts = {}
+
+    def round_end(self, still_decoding: bool) -> None:
+        self.last_end = self.clock() if still_decoding else None
+        self.parts = {}
+
+    @contextmanager
+    def phase(self, name: str) -> Generator[None, None, None]:
+        start = self.clock()
+        try:
+            yield
+        finally:
+            if self.last_end is not None:
+                spent = self.clock() - max(start, self.last_end)
+                if spent > 0:
+                    self.parts[name] = self.parts.get(name, 0.0) + spent
+
+    def health(self) -> dict:
+        with self.lock:
+            return {"gaps": self.gaps, "worst_s": round(self.worst, 3),
+                    "over": {f"{b:g}": n for b, n in self.over.items()}, "recent": list(self.recent),
+                    "now": round(self.wall(), 3)}     # the engine's clock: a reader elsewhere places "ended" by it
