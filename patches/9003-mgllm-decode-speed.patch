+def decode_rate(generated: int, decode: float | None) -> float | None:
+    """A finished request's decode rate: the tokens it decoded (its first token comes from the prompt pass) over its
+    decode seconds; None under RATE_MIN_TOKENS decoded tokens or without a decode time."""
+
+    if decode is None or decode <= 0 or generated - 1 < RATE_MIN_TOKENS:
+        return None
+    return (generated - 1) / float(decode)
 
 
