# Each finished request's decode time and decode rate on /metrics, for decode-speed percentiles on mgllm's dashboard.
# TensorFold v0.6.0 has the finished requests' summed decode seconds only (tensorfold_health:decode_seconds_total), so a
# scraper can compute an average, never a spread. Backport of TensorFold v0.6.3's c9259c3 (sxuf, "/metrics times each
# request's decode"): tensorfold:request_decode_seconds, a histogram of each finished request's decode time (the engine's
# own decode_s, else first token to end), as upstream has it (its vLLM-named mirror is not taken: v0.6.0 has no mirror
# section). Ours on top: tensorfold:request_decode_tokens_per_second, a histogram of each finished request's decode rate,
# tokens decoded after its first over its decode seconds, buckets 1-300 tok/s, observed only for replies decoding at
# least 32 tokens (a reply of a round or two says little about speed); histogram_quantile() on it gives the p50/p90
# decode speed of real requests. Histogram takes its own bucket edges (default unchanged). mgllm, 2026-10-06.
# Tests: tests/test_9003_decode_speed.py; upstream TensorFold's tests/test_metrics.py decode test at v0.6.5.

diff --git tensorfold/cuda/health.py tensorfold/cuda/health.py
index 18d2722..b69b622 100644
--- tensorfold/cuda/health.py
+++ tensorfold/cuda/health.py
@@ -65,10 +65,17 @@ class Health:
 
     def _metrics(self, request: Request) -> None:
         stats = request.stats or {}
+        ended = time.perf_counter()
+        # The engine's own decode time when it reports one (the same figure /health sums); else first token to end.
+        decode = stats.get("decode_s")
+        if not isinstance(decode, (int, float)) or isinstance(decode, bool):
+            decode = (ended - request.first) if request.first is not None else None
         metrics.note(getattr(self, "app", None), prompt=request.prompt, generation=len(request.out),
                      drafted=_stat(stats, "drafted"), accepted=_stat(stats, "accepted"),
-                     latency=max(0.0, time.perf_counter() - request.started),
-                     ttft=(request.first - request.started) if request.first is not None else None)
+                     latency=max(0.0, ended - request.started),
+                     ttft=(request.first - request.started) if request.first is not None else None,
+                     decode=None if decode is None else max(0.0, float(decode)),
+                     rate=metrics.decode_rate(len(request.out), decode))
 
     def snapshot(self, app) -> dict[str, Any]:
         """The counters now: finished totals, live replies' tokens so far, and a concurrent engine's streams."""
