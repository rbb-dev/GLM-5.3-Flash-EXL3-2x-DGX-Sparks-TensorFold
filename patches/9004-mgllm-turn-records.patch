+            out = result.get("out") or []
+            why = turn_records.eligibility(
+                chat=True, thinking=prepared.thinking, draft=body.get("draft", True) is not False,
+                ignore_eos=prepared.ignore_eos, kwargs=body.get("chat_template_kwargs"),
+                pictures=prepared.vision is not None, result=result, out=out,
+                think_close=self.tok.token_to_id("</think>"), call_open=self.tok.token_to_id("<tool_call>"),
+                runs=int(holder.get("runs") or 0))
+            if why is None and not isinstance(v, View):
+                why = v if isinstance(v, str) else "no view"
+            state = None
+            if why is None:
+                kid = holder.get("kid")
+                multi = getattr(self.engine, "multi", None)
+                state = next((c for c in list(getattr(multi, "kept", None) or ()) if c.kid == kid), None) \
+                    if kid is not None else None
+                why = None if state is not None else "no own state" if kid is None else "state gone"
+            if why is None:
