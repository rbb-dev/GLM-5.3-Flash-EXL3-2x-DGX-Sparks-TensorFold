index 0000000..731badf
--- /dev/null
+++ tensorfold/families/glm5_next/cuda/labels.py
@@ -0,0 +1,270 @@
+"""Patch 9004: the labels of a conversation's visible structure, for turn records kept with their states.
+
+A label names a conversation through one of its assistant turns by what every client sends back of it: the roles of
+its messages in order, each message's rendered text, the tools block and the effort line. Never the reasoning: clients
+drop it, trim it or rewrite it. It comes from ONE marked render: the template's own render of the request, with
+per-request marks (``\\x00``-delimited, a fresh nonce each render) at the start of each message's content and around
+each assistant turn's reasoning. Taking the marks out gives the production text byte for byte (``Render.real``);
+taking the reasoning spans out as well gives the label text (``Render.label``). A message starts where its mark sits,
+minus the template text that must precede it (``<|user|>``, ``<|assistant|><think>``, ...). A start that does not read
+as expected is no boundary at all, so a label is never guessed: anything unexpected is a miss.
+
+A label is bound to structure, not only to text: the roles and each message's own span are hashed separately, so a
+record with an extra hidden turn can never equal a request whose same bytes sit inside one message.
+
+Labels come from ONE pass: a running sha256 is fed the header, then each message in order (its role; its span
+when its start is verified, each span running to the next verified start), and a copy is finished at each
+assistant turn's end. A request's labels take one pass over its render (a second keeps the running hash before the
+generation prompt), so the cost grows with the conversation, not with turns x size.
+A reply's label at its end continues the request's own pass with the reply message rendered alone
+(``prefix_state``, ``continue_label``): the template renders an assistant message the same wherever it sits,
+except whether its reasoning shows, which labels leave out."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import re
+import secrets
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+LABEL_VERSION = 4
+# chat_template_kwargs keys a request may set and still take the label path : anything else could
+# replace the conversation (``messages``), the tools header (``tools``) or the prompt's end (``add_generation_prompt``)
+ALLOWED_KWARGS = frozenset({"clear_thinking", "enable_thinking", "reasoning_effort", "thinking"})
+GEN = "<|assistant|><think>"                     # the generation prompt of a thinking request
+EXPECT = {"user": ("<|user|>",), "system": ("<|system|>",), "developer": ("<|system|>",),
+          "assistant": ("<|assistant|><think>", "<|assistant|><think></think>"),
+          "tool": ("<|observation|><tool_response>",)}
+
+
+def kwargs_allowed(kwargs: Any) -> bool:
+    """Whether a request's ``chat_template_kwargs`` let it take the label path (absent or allowlisted keys only)."""
+
+    return kwargs is None or (isinstance(kwargs, dict) and set(kwargs) <= ALLOWED_KWARGS)
+
+
+def _text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        return "".join(p.get("text", "") for p in content if isinstance(p, dict) and isinstance(p.get("text"), str))
+    return ""
+
+
+def reasoning_of(m: dict[str, Any]) -> tuple[str | None, Any]:
+    """(reasoning or None, content) of an assistant message, by the template's own rule: ``reasoning_content`` (or
+    ``reasoning``) when it is a string, else a ``<think>...</think>`` block at the start of the content."""
+
+    rc = m.get("reasoning_content")
+    if not isinstance(rc, str) and isinstance(m.get("reasoning"), str):
+        rc = m["reasoning"]
+    content = m.get("content")
+    if isinstance(rc, str):
+        return rc, content
+    text = _text(content)
+    if "</think>" in text:
+        return text.split("</think>")[0].split("<think>")[-1], text.split("</think>")[-1]
+    return None, content
+
+
+def digest(text: Any) -> str:
+    """A reasoning text's digest as compared between a record and a request: stripped; "" is ``EMPTY``."""
+
+    text = text.strip() if isinstance(text, str) else ""
+    return hashlib.sha256(text.encode("utf-8", "surrogatepass")).hexdigest()[:32] if text else "EMPTY"
+
+
+class Marks:
+    """One render's marks: ``m`` at a message's content start, ``rs`` / ``re`` around an assistant's reasoning."""
+
+    def __init__(self, nonce: str | None = None) -> None:
+        self.nonce = nonce or secrets.token_hex(8)
+        self.pattern = re.compile("\x00tf-(m|rs|re)-" + re.escape(self.nonce) + r":(\d+)\x00")
+
+    def __call__(self, kind: str, i: int) -> str:
+        return f"\x00tf-{kind}-{self.nonce}:{i}\x00"
+
+    def apply(self, messages: list[Any]) -> list[Any]:
+        """A deep copy of ``messages`` with every message's marks in place (assistant reasoning always defined, "" when
+        the message has none, which the template renders exactly as no reasoning: ``<think></think>``)."""
+
+        out = []
+        for i, m in enumerate(messages):
+            m = copy.deepcopy(m)
+            role = m.get("role") if isinstance(m, dict) else None
+            if role == "assistant":
+                reasoning, content = reasoning_of(m)
+                m.pop("reasoning", None)
+                m["content"] = self("m", i) + _text(content).strip()
+                m["reasoning_content"] = self("rs", i) + (reasoning or "") + self("re", i)
+            elif role in ("user", "system", "developer") or (role == "tool" and isinstance(m.get("content"), str)):
+                c = m.get("content")
+                if isinstance(c, str):
+                    m["content"] = self("m", i) + c
+                elif isinstance(c, list):
+                    m["content"] = [{"type": "text", "text": self("m", i)}] + c
+            out.append(m)
+        return out
+
+
+@dataclass
+class Render:
+    """A marked render, analysed: the production text (``real``), the label text (reasoning spans out), and where
+    each message with a verified start begins in each, by message index; ``roles``: every message's role."""
+
+    real: str
+    label: str
+    start_real: dict[int, int] = field(default_factory=dict)
+    start_label: dict[int, int] = field(default_factory=dict)
+    roles: list[str] = field(default_factory=list)
+
+
+def analyse(text: str, messages: list[Any], marks: Marks) -> Render:
+    """Split a marked render into its production text and label text, and verify each message's start."""
+
+    real: list[str] = []
+    label: list[str] = []
+    rlen = llen = pos = 0
+    hidden = False
+    first: dict[tuple[int, str], tuple[int, int]] = {}          # (message, kind) -> (real offset, label offset)
+    for m in marks.pattern.finditer(text):
+        piece = text[pos:m.start()]
+        real.append(piece)
+        rlen += len(piece)
+        if not hidden:
+            label.append(piece)
+            llen += len(piece)
+        kind, i = m.group(1), int(m.group(2))
+        first.setdefault((i, kind), (rlen, llen))
+        hidden = kind == "rs" or (hidden and kind != "re")
+        pos = m.end()
+    real.append(text[pos:])
+    if not hidden:
+        label.append(text[pos:])
+    out = Render("".join(real), "".join(label), roles=[str(m.get("role")) if isinstance(m, dict) else "" for m in
+                                                         messages])
+    i = 0
+    while i < len(messages):
+        role = out.roles[i]
+        if role == "tool":                           # a block of results: the first rendered one opens <|observation|>
+            j = i
+            while j < len(messages) and out.roles[j] == "tool":
+                j += 1
+            found = [first[(k, "m")] for k in range(i, j) if (k, "m") in first]
+            if found:
+                r0, l0 = min(found)
+                _verify(out, i, r0, l0, EXPECT["tool"][0])
+            i = j
+            continue
+        if role == "assistant":
+            if (i, "rs") in first:
+                r0, l0 = first[(i, "rs")]
+                _verify(out, i, r0, l0, EXPECT["assistant"][0])
+            elif (i, "m") in first:
+                r0, l0 = first[(i, "m")]
+                _verify(out, i, r0, l0, EXPECT["assistant"][1])
+        elif role in EXPECT and (i, "m") in first:
+            r0, l0 = first[(i, "m")]
+            _verify(out, i, r0, l0, EXPECT[role][0])
+        i += 1
+    return out
+
+
+def _verify(out: Render, i: int, r0: int, l0: int, pre: str) -> None:
+    if r0 >= len(pre) and out.real[r0 - len(pre):r0] == pre and out.label[l0 - len(pre):l0] == pre:
+        out.start_real[i], out.start_label[i] = r0 - len(pre), l0 - len(pre)
+
+
+def blob(x: str | bytes) -> bytes:
+    """``x`` as it is hashed: its UTF-8 bytes (a lone surrogate kept as is), after their length."""
+
+    b = x.encode("utf-8", "surrogatepass") if isinstance(x, str) else x
+    return len(b).to_bytes(8, "little") + b
+
+
+def _pass(ns: bytes, render: Render, stop: int | None = None):
+    """Run the one pass: yields (message index, the hash after that message). ``stop``: where the text ends for the
+    last span (the generation prompt's start), else the text's end."""
+
+    starts = sorted(render.start_label)
+    h = hashlib.sha256(ns)
+    h.update(blob(render.label[:render.start_label[starts[0]]]))
+    end = len(render.label) if stop is None else stop
+    after = {s: (starts[k + 1] if k + 1 < len(starts) else None) for k, s in enumerate(starts)}
+    for i, role in enumerate(render.roles):
+        h.update(blob(role))
+        if i in render.start_label:
+            nxt = after[i]
+            hi = render.start_label[nxt] if nxt is not None else end
+            h.update(b"S" + blob(render.label[render.start_label[i]:hi]))
+        else:
+            h.update(b"N")
+        yield i, h
+
+
+def struct_labels(ns: bytes, render: Render) -> dict[int, str]:
+    """{assistant message j: its label}, for each assistant turn whose start and end (the next message's start) are
+    verified."""
+
+    if not render.start_label:
+        return {}
+    out: dict[int, str] = {}
+    n = len(render.roles)
+    for i, h in _pass(ns, render):
+        if render.roles[i] == "assistant" and i in render.start_label and i + 1 < n and i + 1 in render.start_label:
+            out[i] = h.copy().hexdigest()[:32]
+    return out
+
+
+def prefix_state(ns: bytes, render: Render):
+    """The pass over a request's whole render, its last span cut before the generation prompt: what a reply's label
+    continues from (``continue_label``). None when the render does not end on the generation prompt or has no start."""
+
+    if not render.start_label or not render.label.endswith(GEN):
+        return None
+    h = None
+    for _, h in _pass(ns, render, stop=len(render.label) - len(GEN)):
+        pass
+    return h.copy() if h is not None else None
+
+
+def continue_label(state, reply: Render) -> str | None:
+    """The label of a reply's turn: the request's pass (``prefix_state``) continued with the reply message, rendered
+    alone without a generation prompt (``reply``: one assistant message). None when its start is not verified."""
+
+    if state is None or reply.roles != ["assistant"] or 0 not in reply.start_label:
+        return None
+    h = state.copy()
+    h.update(blob("assistant"))
+    h.update(b"S" + blob(reply.label[reply.start_label[0]:]))
+    return h.hexdigest()[:32]
+
+
+def file_sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for block in iter(lambda: f.read(1 << 20), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def content_id(model_dir: Path) -> str:
+    """The checkpoint's content: its weight files' blob names in a Hugging Face snapshot (content hashes), else each
+    file's name and size (a local folder: weaker, but a change of weights still shows)."""
+
+    parts = []
+    for p in sorted(Path(model_dir).glob("*.safetensors")):
+        target = p.resolve()
+        parts.append(f"{p.name}={target.name if target != p else p.stat().st_size}")
+    return hashlib.sha256("\n".join(parts).encode()).hexdigest()[:32]
+
+
+def namespace(tokenizer_sha: str, template_sha: str, clear_thinking: bool, checkpoint: str, salt: str = "") -> bytes:
+    """The namespace every label lives in: a change of tokenizer, template, thinking rule or weights
+    starts a new one, so no record made under another can ever match."""
+
+    return hashlib.sha256("|".join(["tf-glm-label", str(LABEL_VERSION), tokenizer_sha, template_sha,
+                                    str(int(bool(clear_thinking))), checkpoint, salt]).encode()).digest()
