diff --git tensorfold/families/glm5_next/cuda/turn_records.py tensorfold/families/glm5_next/cuda/turn_records.py
new file mode 100644
index 0000000..747446f
--- /dev/null
+++ tensorfold/families/glm5_next/cuda/turn_records.py
@@ -0,0 +1,278 @@
+"""Patch 9004: turn records, kept as two fields of the kept prompt state they continue (``decode.Snapshot``), so the
+spill tier saves, scans, loads and evicts them with that state: one cache, one eviction.
+
+A record maps a conversation as clients send it back (reasoning dropped, trimmed or rewritten) onto the exact tokens the
+engine read and wrote: ``T = state.ids[:base] + tail``. Its key (``turn_key``, a short plain string the tier keeps in
+RAM) holds what the lookup indexes: the label of the turn it covers, the conversation's call-id vector, ``T``'s sha256,
+how many assistant turns it covers, and ``base``. Its body (``turn``, a one-element list the tier saves but does not
+keep in RAM) holds ``tail`` and the per-turn table that 9005's checks (``resume.verify``) read.
+
+Only a clean finish gets a record: the model's own end token, a closed think block with no call written inside it,
+every call it wrote parsed and sent, one engine run, no ``ignore_eos``, allowlisted ``chat_template_kwargs``, reasoning
+that is not a loop, and not a ``"draft": false`` reference. Its label is the request's own label pass continued with the
+reply message rendered alone (``labels.continue_label``)."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import zlib
+from array import array
+from dataclasses import dataclass, field
+from typing import Any
+
+from . import labels as L
+
+RECORD = "r4"
+_OUR_ID = re.compile(r"^call_[0-9a-f]{24}$")      # the ids this server gives its calls (``server/tools.py``)
+MAX_REASONING_TOKENS = 65536        # a longer reasoning is not recorded
+LOOP_RATIO = 8.0                     # a reasoning tail compressing past this is a loop (issue #89)
+LOOP_TAIL = 16 << 10                 # bytes of the reasoning's end the ratio is measured on
+LOOP_MIN = 1 << 10                   # shorter tails are never judged
+
+
+# -- the record's two fields ---------------------------------------------------------------------------------------
+def record_key(label: str, idvec: str, t_sha: str, turns: int, base: int) -> str:
+    return f"{RECORD}|{label}|{idvec}|{t_sha}|{int(turns)}|{int(base)}"
+
+
+def parse_key(key: Any) -> dict[str, Any] | None:
+    """The fields of a record key, or None for anything that is not one."""
+
+    if not isinstance(key, str):
+        return None
+    parts = key.split("|")
+    if len(parts) != 6 or parts[0] != RECORD:
+        return None
+    try:
+        return {"label": parts[1], "idvec": parts[2], "t_sha": parts[3], "turns": int(parts[4]),
+                "base": int(parts[5])}
+    except ValueError:
+        return None
+
+
+def record_body(tail: list[int], table: list[dict[str, Any]]) -> list[str]:
+    return [json.dumps({"tail": [int(t) for t in tail], "turns": table}, ensure_ascii=False, separators=(",", ":"))]
+
+
+def _body(body: Any) -> dict[str, Any]:
+    if not (isinstance(body, list) and len(body) == 1 and isinstance(body[0], str)):
+        raise ValueError("not a record body")
+    out = json.loads(body[0])
+    if not isinstance(out, dict) or not isinstance(out.get("tail"), list) or not isinstance(out.get("turns"), list):
+        raise ValueError("not a record body")
+    return out
+
+
+def body_tail(body: Any) -> list[int]:
+    return [int(t) for t in _body(body)["tail"]]
+
+
+def body_table(body: Any) -> list[dict[str, Any]]:
+    return list(_body(body)["turns"])
+
+
+def t_digest(T: list[int]) -> str:
+    """sha256 of T as 32-bit integers (native order; checked against records made on the same machine)."""
+
+    return hashlib.sha256(array("i", T).tobytes()).hexdigest()
+
+
+def idvec_digest(ids: list[list[str]]) -> str:
+    return hashlib.sha256(json.dumps(ids, separators=(",", ":")).encode()).hexdigest()[:32]
+
+
+def continues(state: Any, T: list[int]) -> bool:
+    """Whether the record on ``state`` (if any) describes a prefix of ``T``: the same conversation's earlier turn.
+    ``state.ids`` must already be a prefix of ``T`` (the caller's own state)."""
+
+    key = parse_key(getattr(state, "turn_key", None))
+    if key is None:
+        return True
+    tail = state._turn_tail if getattr(state, "_turn_tail", None) is not None else body_tail(state.turn)
+    base = key["base"]
+    return base <= len(state.ids) and T[base:base + len(tail)] == tail
+
+
+# -- which replies get one --------------------------------------------------------------------------------------------
+@dataclass
+class Turn:
+    """An assistant turn of a request as rendered: its message index (after ``agent_history``), where its reasoning
+    came from, its digest, its call ids as presented, whether the template shows its reasoning, its visible text."""
+
+    msg: int
+    prov: str                        # own | client | restored-id | restored-sig | empty
+    digest: str
+    ids: list[str]
+    shown: bool
+    content: str = ""
+
+    def record(self) -> dict[str, Any]:
+        return {"msg": self.msg, "prov": self.prov, "digest": self.digest, "ids": self.ids, "shown": self.shown}
+
+
+@dataclass
+class View:
+    """A request seen through one marked render: what a record of its reply is built from (``prefix``: the label
+    pass through the request, cut before the generation prompt), and what 9005's lookup found."""
+
+    ns: str
+    render: L.Render
+    history: list[Any]
+    turns: list[Turn]
+    labels: dict[int, str] = field(default_factory=dict)
+    prefix: Any = None
+    hit: Any = None
+    hit_turn: int | None = None
+    t_len: int = 0
+    suffix: int = 0
+    reason: str = ""
+    context: list[int] | None = None
+    hit_table: list[dict[str, Any]] | None = None    # the hit record's rows for the turns it covers (9005)
+
+
+def loop_reason(reasoning: str, content: str, calls: Any, reasoning_tokens: int,
+                max_tokens: int = MAX_REASONING_TOKENS) -> str | None:
+    """Why a reply's reasoning must not be carried into later turns, or None."""
+
+    if not (content or "").strip() and not calls:
+        return "an empty answer"
+    if reasoning_tokens > max_tokens:
+        return f"reasoning over {max_tokens} tokens"
+    tail = (reasoning or "")[-LOOP_TAIL:].encode("utf-8", "surrogatepass")
+    if len(tail) >= LOOP_MIN and len(tail) / max(1, len(zlib.compress(tail, 6))) > LOOP_RATIO:
+        return "repetitive reasoning"
+    return None
+
+
+def eligibility(*, chat: bool, thinking: bool, draft: bool, ignore_eos: bool, kwargs: Any, pictures: bool,
+                result: dict[str, Any], out: list[int], think_close: int | None, call_open: int | None,
+                runs: int = 1, max_reasoning: int = MAX_REASONING_TOKENS) -> str | None:
+    """Why a finished reply gets no record, or None."""
+
+    if not chat:
+        return "not a chat request"
+    if not thinking:
+        return "thinking off"
+    if pictures:
+        return "pictures"
+    if not draft:
+        return "draft:false"
+    if ignore_eos:
+        return "ignore_eos"
+    if not L.kwargs_allowed(kwargs):
+        return "chat_template_kwargs"
+    if runs != 1:
+        return "several engine runs"
+    if not result.get("ended"):
+        return "not ended by the model"
+    if think_close is None or think_close not in out:
+        return "no </think>"
+    if call_open is not None and call_open in out and out.index(call_open) < out.index(think_close):
+        return "a call in the think block"         # a model slip: one cache miss is its whole cost
+    if result.get("closed_call"):
+        return "a call the server closed"
+    calls = result.get("calls") or []
+    if call_open is not None and out.count(call_open) != len(calls):
+        return "calls cut"
+    return loop_reason(result.get("reasoning") or "", result.get("content") or "", calls,
+                       int(result.get("reasoning_tokens") or 0), max_reasoning)
+
+
+def reply_message(result: dict[str, Any]) -> dict[str, Any]:
+    """The reply as a client would send it back with its reasoning: the message its label covers."""
+
+    m: dict[str, Any] = {"role": "assistant", "content": result.get("content") or "",
+                         "reasoning_content": result.get("reasoning") or ""}
+    if result.get("calls"):
+        m["tool_calls"] = [dict(c) for c in result["calls"]]
+    return m
+
+
+def make_record(template, view: View, result: dict[str, Any], *, prompt: list[int], out: list[int], tools: Any,
+                kwargs: dict[str, Any] | None, base: int) -> tuple[str, list[str], list[int]] | str:
+    """(key, body, tail) of an eligible reply's record on a state of ``base`` tokens, or why not."""
+
+    marks = L.Marks()
+    text, history = template.render_marked([reply_message(result)], tools=tools,
+                                           extra={**(kwargs or {}), "add_generation_prompt": False}, marks=marks)
+    label = L.continue_label(view.prefix, L.analyse(text, history, marks))
+    if label is None:
+        return "label"
+    T = list(prompt) + list(out[:-1])
+    if not 0 < base <= len(prompt):
+        return "state outside the prompt"
+    reply = Turn(len(view.history), "own", L.digest(result.get("reasoning")),
+                 [c["id"] for c in result.get("calls") or [] if isinstance(c, dict) and isinstance(c.get("id"), str)],
+                 True)
+    turns = [*view.turns, reply]
+    idvec = idvec_digest([t.ids for t in turns if t.ids])
+    rows = [t.record() for t in turns]
+    if view.hit is not None and view.hit_table is not None and view.hit_turn is not None:
+        # served from a record: T holds the turns it covered as that record says (their thinking included), not as
+        # this request presented them (a client that dropped the thinking would make them look empty)
+        rows = [*view.hit_table, *(t.record() for t in view.turns if t.msg > view.hit_turn), reply.record()]
+    tail = T[base:]
+    return (record_key(label, idvec, t_digest(T), len(turns), base), record_body(tail, rows), tail)
+
+
+# -- the request's side ----------------------------------------------------------------------------------------------
+def _text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        return "".join(p.get("text", "") for p in content if isinstance(p, dict) and isinstance(p.get("text"), str))
+    return ""
+
+
+def turns_of(original: list[Any], history: list[Any], clear_thinking: bool) -> list[Turn] | None:
+    """Every assistant turn as rendered, with its provenance (what ``resume.verify`` checks): the client's own
+    reasoning (``client``), else reasoning 0036 put back (``restored-id`` when a call id is ours, else
+    ``restored-sig``), else ``empty``.
+    None when the client's assistant messages and the rendered ones cannot be paired one to one."""
+
+    sent = [m for m in original if isinstance(m, dict) and m.get("role") == "assistant"]
+    rendered = [(i, m) for i, m in enumerate(history) if isinstance(m, dict) and m.get("role") == "assistant"]
+    if len(sent) != len(rendered):
+        return None
+    last_user = max((i for i, m in enumerate(history) if isinstance(m, dict) and m.get("role") == "user"), default=-1)
+    out = []
+    for client, (i, m) in zip(sent, rendered):
+        own, _ = L.reasoning_of(client)
+        now, content = L.reasoning_of(m)
+        ids = [c["id"] for c in client.get("tool_calls") or [] if isinstance(c, dict) and isinstance(c.get("id"), str)]
+        if isinstance(own, str) and own.strip():
+            prov, text = "client", own
+        elif isinstance(now, str) and now.strip():
+            prov, text = ("restored-id" if any(_OUR_ID.match(c) for c in ids) else "restored-sig"), now
+        else:
+            prov, text = "empty", ""
+        shown = not clear_thinking or i > last_user
+        out.append(Turn(i, prov, L.digest(text), ids, shown, _text(content).strip()))
+    return out
+
+
+def view(template, body: dict[str, Any], prepared, ns: bytes, clear_thinking: bool) -> View | str:
+    """The request through one marked render, or why it takes no label path."""
+
+    if not prepared.thinking:
+        return "thinking off"
+    if not L.kwargs_allowed(body.get("chat_template_kwargs")):
+        return "chat_template_kwargs"
+    if prepared.vision is not None or prepared.text is None:
+        return "pictures"
+    # the thinking rule this request renders with (its own clear_thinking, else the server's) is part of its
+    # namespace: a record made under the other rule never serves it
+    clear = bool((prepared.template_kwargs or {}).get("clear_thinking", clear_thinking))
+    ns = hashlib.sha256(ns + (b"|clear:1" if clear else b"|clear:0")).digest()
+    marks = L.Marks()
